# ==============================================================================
# CAMPUSNOTES Backend Environment Configuration
# ==============================================================================

# Server & Database Settings
PORT=5002
MONGO_URI=mongodb://127.0.0.1:27017/campus-notes
JWT_SECRET=your-secret-key-change-in-production
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Local development:
#   AI_PROVIDER=ollama
#   EMBEDDING_PROVIDER=ollama
#
# Production / Cloud deployment:
#   AI_PROVIDER=openai
#   EMBEDDING_PROVIDER=openai
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Ollama Settings (Local AI)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# OpenAI Settings (Server-side ONLY - Never expose to frontend/client)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: OPENAI_EMBEDDING_DIMENSIONS=1536
