# ==============================================================================
# CAMPUSNOTES Backend Production Deployment Configuration
# ==============================================================================

# Server & Database Settings
PORT=5002
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus-notes?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_long_random_jwt_secret_in_production
CLIENT_URL=https://your-production-domain.com

# ------------------------------------------------------------------------------
# Production AI Provider Settings
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini Settings (Server-side ONLY - Never expose to frontend/client)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
